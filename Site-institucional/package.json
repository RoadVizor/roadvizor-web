{
  "name": "roadvizor-web",
  "version": "1.0.0",
  "description": "RoadVizor - Módulo WEB",
  "main": "app.js",
  "scripts": {
    "start": "npx @tailwindcss/cli -i ./public/css/style.css -o ./public/css/output.css & node app.js",
    "dev": "concurrently \"npx @tailwindcss/cli -i ./public/css/style.css -o ./public/css/output.css --watch\" \"nodemon --exec node app.js\""
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.9.4",
    "nodemon": "^2.0.7",
    "path": "^0.12.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
